# Copy to .env and fill in for your machine. .env is gitignored.
#
# This repo is PUBLIC. Nothing machine-specific — no absolute paths, no account
# ids, no tokens — belongs in a tracked file. tests/test_no_leaks.py enforces it.

# ─── OOTP game install ────────────────────────────────────────────────────────
# The folder containing ootp25.exe. Its data/database/ subfolder holds the
# shipped reference data this project reads (players.csv, names.xml, the era
# and financial constant tables). See docs/data-access.md §2.
OOTP_INSTALL=

# ─── Saved games root ─────────────────────────────────────────────────────────
# The folder containing the *.lg save directories. NOT under the install —
# on Windows it lands in Documents, which may be OneDrive-redirected.
# See docs/data-access.md §1.
OOTP_SAVED_GAMES=

# ─── The league being managed ─────────────────────────────────────────────────
# Name of the *.lg directory under OOTP_SAVED_GAMES, without the extension.
OOTP_LEAGUE=

# ─── Validation saves ─────────────────────────────────────────────────────────
# Two non-managed saves, each named the same way OOTP_LEAGUE is. Both optional:
# the offline suite and CI have neither, and code must degrade rather than fail.
#
# The RETAINED STANDARD-MODE save. Paired with MYSQL_TRUTH_REAL_DATABASE below,
# which was exported from it. This is the ONLY save that can prove the parser
# correct row-for-row, because Challenge Mode has no export — so it is a retained
# validation asset, NOT a disposable probe. Do not delete it, and do not sim it.
OOTP_TRUTH_LEAGUE=
# Optional. Defaults to OOTP_SAVED_GAMES; set only if you moved this save out of
# the game's own folder to keep it safe.
OOTP_TRUTH_SAVED_GAMES=

# The DISPOSABLE CHALLENGE-MODE save. Same mode and same club as the managed
# league, so it is a structural twin of production and is the right target for
# developing and rehearsing the pipeline. Every filesystem-touching test runs
# here FIRST and only then against the managed league.
OOTP_PROBE_LEAGUE=
OOTP_PROBE_SAVED_GAMES=

# ─── Snapshot store ───────────────────────────────────────────────────────────
# Where per-sim-date save snapshots are copied to. MUST be on local disk, not
# a cloud-synced folder — config.py refuses a path under %OneDrive%. Only the
# three parsed files are copied (~46MB), not the whole ~600MB .lg directory.
# Defaults to var/snapshots.
OOTP_SNAPSHOT_ROOT=

# ─── Rendered output ──────────────────────────────────────────────────────────
# Where the roster report and the generated half of the catalog are written, under
# <root>/<save_id>/<sim_date>/<ingest_seq>/ so a re-render never overwrites the
# snapshot a past decision was made from. Defaults to var/reports.
#
# MUST be git-ignored: a rendered roster is OOTP's player data and this repo is
# public (ADR 0006). This is now ENFORCED rather than requested — config refuses an
# in-worktree root that git would not ignore, and refuses any root resolving inside
# the install or the saved games (ADR 0001). A root outside the worktree is fine.
OOTP_OUTPUT_ROOT=

# ─── Warehouse (MySQL) ────────────────────────────────────────────────────────
# See ADR 0004. Local instance; no cloud, no cost.
#
# This is the APPLICATION user the pipeline connects as.
#
# The root password is deliberately NOT stored here. It is NOT single-use,
# though: you need it again for grants, user management, and recovery.
#
#   >> Put the root password in a password manager BEFORE you finish setup. <<
#
# If this file is its only copy, deleting the line loses it, and getting back
# in costs a service stop and an --init-file password reset. Learned the hard
# way; see ops/README.md.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=

# The warehouse. Written ONLY by our parser (ADR 0002).
#
# NEVER point the game's "Export data directly into a MySQL database" at this
# one. Its own dialog warns that it overwrites tables whose names collide, and
# mixing vendor-exported tables with parsed ones destroys the provenance line
# that makes a data incident triageable.
# Use `ootp_dev` while developing and `ootp` for the managed league. Isolation
# between universes is enforced by save_id in every primary key, but that is a
# column: a SELECT that forgets it mixes two universes silently. The schema split
# is defence in depth and costs one value here.
MYSQL_DATABASE=ootp_dev

# Ground truth, exported by the game from the RETAINED STANDARD-MODE save — the
# export does not exist in Challenge Mode. See docs/data-access.md §6.
#
# NOTHING IN THIS PROJECT WRITES HERE. src/ootp_ai/db.py opens it with a
# read-only session, because it is the only artifact that can prove the parser
# correct and rebuilding it costs a save rebuild plus an export run.
MYSQL_TRUTH_REAL_DATABASE=ootp_truth_real

# ─── Reference checkouts, if you have them locally ────────────────────────────
# Neither is a dependency — nothing in this repo reads either one.
NBA_ANALYSIS_PATH=
POKEMON_LAB_PATH=
